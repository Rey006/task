---
import { getCollection, getEntry, render } from 'astro:content';

// 1. Fetch Company backbone
const companyEntry = await getEntry('company', 'company');

if (!companyEntry) {
  throw new Error("Critical error: File src/content/company/company.md is missing!");
}

const { Content: BioContent } = await render(companyEntry);

// 2. Fetch Services and sort by order
const allServices = await getCollection('services');
const sortedServices = allServices.sort((a, b) => a.data.order - b.data.order);

// 3. Fetch Featured Projects
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.featured === true)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    
    <title>{companyEntry.data.seo.title}</title>
    <meta name="description" content={companyEntry.data.seo.description} />
  </head>
  <body>
    <main class="container">
      
      <!-- HERO SECTION -->
      <header class="hero-section">
        <div class="hero-main">
          <span class="brand-tag">{companyEntry.data.name}</span>
          <h1>{companyEntry.data.claim}</h1>
        </div>
        
        <div class="hero-sidebar">
          <div class="status-card">
            <div class="status-header">
              <span class="status-dot"></span>
              <span class="status-text">{companyEntry.data.availability ?? 'Disponibile per nuovi progetti'}</span>
            </div>
            <div class="meta-info">
              <span>📍 {companyEntry.data.city}</span>
              <span class="area">({companyEntry.data.servedArea.join(', ')})</span>
            </div>
          </div>
        </div>
      </header>

      <hr class="divider" />

      <!-- ABOUT SECTION -->
      <section class="section about-section">
        <div class="about-grid">
          <h2>Chi Siamo</h2>
          <div class="bio-markdown">
            <BioContent />
          </div>
        </div>
      </section>

      <hr class="divider" />

      <!-- SERVICES SECTION -->
      <section class="section">
        <h2>Servizi</h2>
        <div class="grid">
          {sortedServices.map((service) => (
            <article class="service-card">
              <h3>{service.data.title}</h3>
              <p class="service-body">{service.data.description}</p>
              <a href={`/services/${service.id}`} class="link">Dettagli &rarr;</a>
            </article>
          ))}
        </div>
      </section>

      <hr class="divider" />

      <!-- PROJECTS SECTION -->
      {featuredProjects.length > 0 && (
        <section class="section">
          <h2>Progetti Selezionati</h2>
          <div class="grid">
            {featuredProjects.map((project) => (
              <article class="project-card">
                {project.data.client && <span class="client">{project.data.client}</span>}
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                
                {project.data.tags && project.data.tags.length > 0 && (
                  <div class="tags">
                    {project.data.tags.map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                )}
                
                <a href={`/projects/${project.id}`} class="link">Vedi Case Study &rarr;</a>
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- CONTACTS -->
      <footer class="footer-contacts">
        <h2>Contatti</h2>
        <p>Email: <a href={`mailto:${companyEntry.data.email}`}>{companyEntry.data.email}</a></p>
        
        {companyEntry.data.social && (
          <div class="socials">
            {companyEntry.data.social.map((s) => (
              <a href={s.url} target="_blank" rel="noopener noreferrer">{s.network}</a>
            ))}
          </div>
        )}
      </footer>

    </main>
  </body>
</html>

<style>
  /* Base Layout */
  :global(body) {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0f172a;
    color: #f8fafc;
    margin: 0;
    padding: 0;
    line-height: 1.6;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .divider {
    border: 0;
    border-top: 1px solid #1e293b;
    margin: 4rem 0;
  }

  /* Hero Section */
  .hero-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .hero-section {
      grid-template-columns: 1.8fr 1fr;
      gap: 3rem;
    }
  }

  .brand-tag {
    display: inline-block;
    color: #38bdf8;
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2.2rem, 4.5vw, 3.8rem);
    font-weight: 800;
    color: #f8fafc;
    margin: 0;
    line-height: 1.1;
  }

  /* Status Card */
  .status-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 1.5rem;
  }

  .status-header {
    display: flex;
    align-items: center;
  }

  .status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background-color: #22c55e;
    border-radius: 50%;
    margin-right: 0.6rem;
    box-shadow: 0 0 8px #22c55e;
    flex-shrink: 0;
  }

  .status-text {
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-info {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #334155;
    color: #94a3b8;
    font-size: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  /* About Layout Split */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 280px 1fr;
      gap: 3rem;
    }
  }

  .about-grid h2 {
    margin: 0;
    font-size: 1.5rem;
  }

  .about-section .bio-markdown {
    color: #cbd5e1;
    font-size: 1.15rem;
    line-height: 1.7;
    margin: 0;
  }

  .about-section .bio-markdown p:first-child {
    margin-top: 0;
  }

  /* Section Titles */
  .section h2, .footer-contacts h2 {
    font-size: 1.5rem;
    color: #f8fafc;
    margin-bottom: 1.5rem;
  }

  /* Grid System Dinamico */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  /* Cards Styling */
  .service-card, .project-card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover, .project-card:hover {
    transform: translateY(-4px);
    border-color: #38bdf8;
    box-shadow: 0 10px 30px -10px rgba(56, 189, 248, 0.15);
  }

  .service-card h3, .project-card h3 {
    font-size: 1.35rem;
    color: #f8fafc;
    margin: 0 0 0.75rem 0;
  }

  .service-body, .project-card p {
    color: #94a3b8;
    font-size: 1rem;
    flex-grow: 1;
    margin-bottom: 1.5rem;
  }

  .client {
    display: inline-block;
    color: #38bdf8;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  /* Link & Tag */
  .link {
    color: #38bdf8;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    align-self: flex-start;
  }

  .link:hover {
    text-decoration: underline;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .tag {
    background: #0f172a;
    color: #94a3b8;
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid #334155;
  }

  /* Footer */
  .footer-contacts a {
    color: #38bdf8;
    text-decoration: none;
  }

  .socials {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
  }

  .socials a {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font-size: 0.95rem;
    transition: background 0.2s, border-color 0.2s;
  }

  .socials a:hover {
    background: #334155;
    border-color: #38bdf8;
  }
</style>