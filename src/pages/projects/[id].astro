---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((projects) => ({
    params: { id: projects.id },
    props: { project: projects },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{project.data.title}</title>
  </head>
  <body>
    <main class="project-detail">
      <a href="/" class="back-link">&lt;- Torna alla Home</a>
      
      <header class="detail-header">
        {project.data.client && <span class="client">{project.data.client}</span>}
        <h1>{project.data.title}</h1>
        <p class="lead-desc">{project.data.description}</p>
        
        {project.data.tags.length > 0 && (
          <div class="tags">
            {project.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <hr class="divider" />

      <article class="markdown-body">
        <Content />
      </article>
    </main>
  </body>
</html>

<style>
  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: #0f172a;
    color: #f8fafc;
    margin: 0;
    padding: 3rem 1.5rem;
  }

  .project-detail {
    max-width: 750px;
    margin: 0 auto;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 16px;
    padding: 2.5rem;
  }

  .back-link {
    display: inline-block;
    color: #38bdf8;
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #7dd3fc;
  }

  .client {
    display: inline-block;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #38bdf8;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: 2.25rem;
    margin: 0 0 0.5rem 0;
    color: #f8fafc;
  }

  .lead-desc {
    font-size: 1.1rem;
    color: #94a3b8;
    margin: 0 0 1rem 0;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.8rem;
  }

  .tag {
    background: #334155;
    color: #cbd5e1;
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
  }

  .divider {
    border: 0;
    border-top: 1px solid #334155;
    margin: 2rem 0;
  }

  .markdown-body :global(h2) {
    font-size: 1.5rem;
    color: #f8fafc;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .markdown-body :global(p) {
    color: #cbd5e1;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .markdown-body :global(ul) {
    color: #cbd5e1;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .markdown-body :global(li) {
    margin-bottom: 0.5rem;
  }
</style>